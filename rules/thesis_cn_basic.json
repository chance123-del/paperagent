{
  "name": "thesis_cn_basic",
  "description": "Simple Chinese thesis profile for demo use.",
  "geometry": "a4paper,top=2.54cm,bottom=2.54cm,left=3.18cm,right=3.18cm",
  "line_spread": "1.5",
  "bibliographystyle": "plain",
  "abstract": {
    "required": true,
    "auto_insert": true,
    "insert_after": "\\maketitle",
    "template": [
      "\\begin{abstract}",
      "TODO: 在此填写摘要内容。",
      "\\end{abstract}"
    ]
  },
  "keywords": {
    "required": true,
    "auto_insert": true,
    "insert_after": "abstract",
    "template": "关键词：待补充1；待补充2；待补充3"
  },
  "caption_prefixes": {
    "figure": "图",
    "table": "表"
  },
  "caption_separators": {
    "figure": "：",
    "table": "："
  },
  "required_elements": {
    "bibliography": true
  }
}
