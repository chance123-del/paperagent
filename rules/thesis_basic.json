{
  "name": "thesis_basic",
  "description": "Baseline thesis formatting rules for the competition MVP.",
  "geometry": "a4paper,margin=2.54cm",
  "line_spread": "1.5",
  "bibliographystyle": "plain",
  "abstract": {
    "required": true,
    "auto_insert": true,
    "insert_after": "\\maketitle",
    "template": [
      "\\begin{abstract}",
      "TODO: Add abstract content.",
      "\\end{abstract}"
    ]
  },
  "keywords": {
    "required": true,
    "auto_insert": true,
    "insert_after": "abstract",
    "template": "Keywords: TODO, TODO, TODO"
  },
  "caption_prefixes": {
    "figure": "Figure",
    "table": "Table"
  },
  "caption_separators": {
    "figure": ": ",
    "table": ": "
  },
  "required_elements": {
    "bibliography": true
  }
}
